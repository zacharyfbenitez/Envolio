FLIGHTAWARE_API_KEY=your_aeroapi_key_here
ENABLE_AWC_METAR_FALLBACK=false
SKYLINK_API_KEY=
ENABLE_AWC_TAF=true
# Match only your hosting provider's trusted proxy topology (0 = direct).
TRUST_PROXY_HOPS=0
