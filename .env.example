FLIGHTAWARE_API_KEY=your_aeroapi_key_here
ENABLE_AWC_METAR_FALLBACK=false
SKYLINK_API_KEY=
ENABLE_AWC_TAF=true
# Match only your hosting provider's trusted proxy topology (0 = direct).
TRUST_PROXY_HOPS=0
TELEMETRY_ADMIN_TOKEN=
# Keep off until consent, unsubscribe, delivery and monitoring are verified.
ENABLE_ALERT_SUBSCRIPTIONS=false
RESEND_API_KEY=
ALERT_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
ALERT_DELIVERY_WEBHOOK=
ALERT_WEBHOOK_SECRET=
 # Optional HTTPS Slack-compatible monitoring webhook; server-side only.
MONITOR_WEBHOOK_URL=
# Authorized adapter URLs below implement docs/TAKEOFF-SLOTS.md, not FAA/NM URLs.
# Keep disabled until written public-display rights and credentials are obtained.
SLOT_FAA_ENABLED=false
SLOT_FAA_PUBLIC_DISPLAY_APPROVED=false
SLOT_FAA_RIGHTS_EXPIRES_AT=
SLOT_FAA_URL=
SLOT_FAA_TOKEN=
SLOT_FAA_PROVIDER_NAME=
SLOT_EUROCONTROL_ENABLED=false
SLOT_EUROCONTROL_PUBLIC_DISPLAY_APPROVED=false
SLOT_EUROCONTROL_RIGHTS_EXPIRES_AT=
SLOT_EUROCONTROL_URL=
SLOT_EUROCONTROL_TOKEN=
SLOT_EUROCONTROL_PROVIDER_NAME=
 # Public, flight-specific FAA form lookup; no SWIM credentials required.
ENABLE_FAA_EDCT_LOOKUP=true
