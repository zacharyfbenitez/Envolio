{
  "name": "envolio-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:slots": "node --test tests/takeoff-slots.test.mjs tests/faa-edct.test.mjs tests/slot-risk.test.mjs",
    "test:embed": "node --test tests/embed.e2e.test.mjs",
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server.js\"",
    "build": "vite build",
    "icons": "node scripts/generate-app-icons.mjs",
    "test:web-launch": "node --test tests/web-security.test.mjs tests/web-launch.e2e.test.mjs",
    "test:docker-runtime": "node --test tests/docker-runtime.test.mjs",
    "test:audit": "node --test tests/traveler-presentation.test.mjs tests/site-audit.e2e.test.mjs",
    "test:operational-risk": "node --test tests/operational-risk.test.mjs tests/risk-audit.test.mjs",
    "test:search": "node --test tests/flight-search.test.mjs && node --test tests/search-discovery.e2e.test.mjs",
    "start": "node server.js",
    "test:regression": "node --test tests/flight-regression.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/search-flow.e2e.test.mjs tests/intelligence.e2e.test.mjs tests/strategy.e2e.test.mjs",
    "test:reasoning": "node --test tests/delay-reasoning.test.mjs",
    "test:providers": "node --test tests/skylink.test.mjs tests/traveler-intelligence.test.mjs tests/trip-strategy.test.mjs",
    "test": "npm run test:providers && npm run test:reasoning && npm run test:regression && npm run test:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "dotenv": "latest",
    "express": "latest",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "puppeteer-core": "^25.10.0"
  }
}
